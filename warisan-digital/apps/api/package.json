{
  "name": "@warisan-digital/api",
  "version": "1.0.0",
  "description": "Backend API untuk Warisan Digital",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@warisan-digital/shared": "*",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.10.0",
    "fastify": "^4.25.2",
    "fastify-cors": "^8.4.2",
    "fastify-jwt": "^7.8.0",
    "fastify-rate-limit": "^9.1.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
